[user]
    email = malaiya.utkarsh@gmail.com
    name = Utkarsh Malaiya
[init]
    defaultBranch = master
[credential]
    username = utkrshm
[alias]
    st = status
    co = checkout
    br = branch
    cm = commit -m
    done = !git push origin HEAD
    lg = !git log --pretty=format:\"%C(magenta)%h%Creset -%C(red)%d%Creset %s %C(dim green)(%cr) [%an]\" --abbrev-commit -30

    # Important, provide the git commit message along with this command
    ac = "!git add -A && git commit -m"
    unstage = restore --staged
    acp = "!f() { git add -A && git commit -m \"$1\" && git push origin HEAD; }; f"	
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
